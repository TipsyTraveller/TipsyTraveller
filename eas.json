{
  "cli": {
    "version": ">= 16.13.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "ios": {
        "simulator": true
      },
      "android": {
        "developmentClient": true,
        "distribution": "internal"
      },
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "beta": {
      "extends": "preview",
      "android": {
        "buildType": "apk"
      },
      "developmentClient": false,
      "env": {
        "EXPO_PUBLIC_ENABLE_DEV_PORTAL": "true"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
