{
  "expo": {
    "name": "TipsyTraveller",
    "slug": "TipsyTraveller",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icons/ios-light.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icons/ios-light.png",
      "bundleIdentifier": "com.nielspet.TipsyTraveller",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/ios-light.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.nielspet.TipsyTraveller"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/dogicapixel.otf",
            "./assets/fonts/dogicapixelbold.otf"
          ]
        }
      ],
      "expo-screen-orientation",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/splash-icon-light.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "fc6c433d-6c8c-4f79-b758-1d6b47ed5ee9"
      }
    }
  }
}
